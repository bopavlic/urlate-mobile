# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are inlined into the JS bundle.

# Leave empty in development: the app uses the Metro host (your Mac) on port 4000.
EXPO_PUBLIC_API_URL=

# Google sign-in (from Google Cloud Console → Credentials). Leave empty to hide the button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd. Native build setting:
# rebuild the dev client (make build-ios) after changing it.
GOOGLE_IOS_URL_SCHEME=

# EAS project ID (from `npx eas-cli@latest init`). Push notifications need it; without it the
# Activity tab still works but this device gets no pushes.
EAS_PROJECT_ID=
# Android push (Firebase Cloud Messaging): path to google-services.json. Native build setting.
GOOGLE_SERVICES_JSON=
